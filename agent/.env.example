# Sarvam (speech-to-text, LLM, text-to-speech) - the default voice mode
SARVAM_API_KEY=

# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres (Neon). Leave empty to use a local SQLite file for tests and console mode.
DATABASE_URL=

# sarvam (default) or gemini (premium, needs GOOGLE_API_KEY)
VOICE_MODE=sarvam
GOOGLE_API_KEY=

# Optional tuning
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER=
