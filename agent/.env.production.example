# Secrets for the deployed agent. Copy to .env.production and fill in.
# LiveKit Cloud injects LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET itself.
SARVAM_API_KEY=
# Hosted Postgres (for example Neon), not the local Docker one
DATABASE_URL=
VOICE_MODE=sarvam
# Optional, only for the Gemini Live voice
GOOGLE_API_KEY=
